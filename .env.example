# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_app

# Auth (use a long random string)
JWT_SECRET=change-this-to-a-long-random-string-of-32-plus-chars
# Set to false if you serve production over plain http
COOKIE_SECURE=true

# First admin (created by `npm run db:setup`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# WhatsApp Cloud API (leave empty in dev: OTP is printed in the server log and shown on the login screen)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=otp_login
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_HAS_BUTTON=true
DEFAULT_COUNTRY_CODE=91

# Image uploads are stored here (outside /public so they work after build)
UPLOAD_DIR=uploads

# Testing only: show the OTP on the login screen when WhatsApp is not configured (always on in `npm run dev`)
OTP_SHOW_IN_RESPONSE=false

# AI: "Copy a design from a photo" in the poster editor (https://console.anthropic.com)
ANTHROPIC_API_KEY=
